@baseUrl = http://localhost:8080

### Listar citas
GET {{baseUrl}}/api/citas?page=0&size=20

### Crear paciente
POST {{baseUrl}}/api/pacientes
Content-Type: application/json

{
  "tipoDocumento": "DNI",
  "numeroDocumento": "48128888",
  "nombres": "Prueba",
  "apellidos": "HTTP Client",
  "tipoSeguro": "Particular",
  "activo": true
}

### Cambiar estado cita
PATCH {{baseUrl}}/api/citas/1/estado
Content-Type: application/json

{
  "estado": "EnTriaje"
}
