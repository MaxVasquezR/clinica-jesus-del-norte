{
  "info": {
    "name": "CitaSync API — Clínica Jesús del Norte",
    "description": "Colección de pruebas funcionales para la API RESTful CitaSync.\nCurso: Desarrollo de Servicios Web — IDAT 2026\n\nAntes de ejecutar: inicia la API en http://localhost:8080.\nLa colección cambia los datos en memoria. Para repetirla completa, reinicia la API primero.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "citaId",
      "value": "1"
    },
    {
      "key": "citaIdNueva",
      "value": "2"
    }
  ],
  "item": [
    {
      "name": "01 - Pacientes",
      "item": [
        {
          "name": "TC01 - Crear paciente (POST)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('success = true', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.eql(true);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipoDocumento\": \"DNI\",\n  \"numeroDocumento\": \"40000003\",\n  \"nombres\": \"Ana Lucía\",\n  \"apellidos\": \"Quispe Ramos\",\n  \"telefono\": \"900000003\",\n  \"email\": \"ana.quispe@example.com\",\n  \"tipoSeguro\": \"Particular\",\n  \"activo\": true\n}",
