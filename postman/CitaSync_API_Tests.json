    {
      "name": "02 - Citas",
      "item": [
        {
          "name": "TC02 - Consulta general de citas (GET)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Respuesta paginada', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.expect(json.data).to.have.property('items');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/citas?page=0&size=20"
          }
        },
        {
          "name": "TC03 - Actualizar estado a EnTriaje (PATCH)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Estado EnTriaje', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.estado).to.eql('EnTriaje');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"EnTriaje\",\n  \"observacionCancelacion\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/citas/{{citaId}}/estado"
          }
        },
        {
          "name": "TC03b - Transición de estado no permitida (422)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/citas/{{citaId}}/estado",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"Finalizada\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 422 Unprocessable Entity', function () {",
                  "    pm.response.to.have.status(422);",
                  "});",
                  "pm.test('success = false', function () {",
                  "    pm.expect(pm.response.json().success).to.eql(false);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC04 - Crear nueva cita (POST)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Siempre 30 días después de hoy, a las 11:00",
                  "var d = new Date();",
                  "d.setDate(d.getDate() + 30);",
                  "var pad = function (n) { return String(n).padStart(2, '0'); };",
                  "pm.collectionVariables.set('fechaCita', d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()) + 'T11:00:00');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var json = pm.response.json();",
                  "if (json.data && json.data.id) {",
                  "    pm.collectionVariables.set('citaIdNueva', json.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pacienteId\": 2,\n  \"medicoId\": 2,\n  \"especialidadId\": 2,\n  \"fechaHoraCita\": \"{{fechaCita}}\",\n  \"motivoConsulta\": \"Control pediátrico de rutina\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/citas"
          }
        },
        {
          "name": "TC04b - Especialidad distinta a la del médico (422)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/citas",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pacienteId\": 2,\n  \"medicoId\": 1,\n  \"especialidadId\": 2,\n  \"fechaHoraCita\": \"{{fechaCita}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 422 Unprocessable Entity', function () {",
                  "    pm.response.to.have.status(422);",
                  "});",
                  "pm.test('success = false', function () {",
                  "    pm.expect(pm.response.json().success).to.eql(false);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC05 - Cancelar cita (DELETE)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Estado Cancelada', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.estado).to.eql('Cancelada');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"observacionCancelacion\": \"Paciente solicitó reprogramación por motivos laborales\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/citas/{{citaIdNueva}}"
          }
        }
      ]
