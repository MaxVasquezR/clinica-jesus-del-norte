          }
        },
        {
          "name": "TC01e - Datos inválidos (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/pacientes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipoDocumento\": \"DNI\",\n  \"numeroDocumento\": \"12\",\n  \"nombres\": \"A\",\n  \"apellidos\": \"Prueba\",\n  \"tipoSeguro\": \"Particular\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test('success = false', function () {",
                  "    pm.expect(pm.response.json().success).to.eql(false);",
                  "});",
                  "pm.test('Lista los errores', function () {",
                  "    pm.expect(pm.response.json().errors.length).to.be.above(0);",
                  "});"
                ]
              }
            }
          ]
        }
